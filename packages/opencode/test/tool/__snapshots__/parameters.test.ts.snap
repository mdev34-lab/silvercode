exports[`tool parameters JSON Schema (wire shape) task 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "background": {
      "description": "Run asynchronously and get notified on completion (default). Agents configured with \`background: false\` in opencode.json run in the foreground and wait for the result; true forces a background launch; false on any other agent still launches it in the background.",
      "type": "boolean",
    },
    "command": {
      "description": "Triggering command",
      "type": "string",
    },
    "description": {
      "description": "A short (3-5 words) description of the task",
      "type": "string",
    },
    "directory": {
      "description": "Working folder for the child's file, search, and edit tools (read, grep, glob, edit, write, apply_patch); omit to inherit this session's folder. Shell commands still default to the project directory and resolve relative workdir from the project directory, so shell commands meant for this folder must pass an explicit absolute workdir. A resumed task keeps the folder it was created with. Choosing a folder is not an authorization: paths outside the project still ask the usual permissions.",
      "type": "string",
    },
    "effort": {
      "description": "Override the child's effort policy; omit to inherit.",
      "enum": [
        "fast",
        "medium",
        "thorough",
      ],
      "type": "string",
    },
    "prompt": {
      "description": "The task for the agent to perform",
      "type": "string",
    },
    "subagent_type": {
      "description": "The type of specialized agent to use for this task",
      "type": "string",
    },
    "task_id": {
      "description": "Resume a previous subagent session by its task_id",
      "type": "string",
    },
  },
  "required": [
    "description",
    "prompt",
    "subagent_type",
  ],
  "type": "object",
}
`;

