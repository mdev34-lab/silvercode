exports[`silvercode CLI help-text snapshots every documented command emits stable help text: silvercode web --help 1`] = `
" ▄▄▄ ▄ ▄ ▄  ▄  ▄▄  ▄▄▄   ▄▄▄  ▄▄     ▄  ▄▄
█    ▄ █ █  █ █  █ █  ▀ █    █  █  ▄▄█ █  █
 ▀▀▄ █ █ █  █ █▀▀▀ █    █    █  █ █  █ █▀▀▀
▄▄▄▀ █ █  ▀▄▀ ▀▄▄▄ █    ▀▄▄▄ ▀▄▄▀ ▀▄▄█ ▀▄▄▄

Commands:
  silvercode completion          generate shell completion script
  silvercode acp                 start ACP (Agent Client Protocol) server
  silvercode mcp                 manage MCP (Model Context Protocol) servers
  silvercode [project]           start silvercode tui                                      [default]
  silvercode attach <url>        attach to a running silvercode server
  silvercode run [message..]     run silvercode with a message
  silvercode debug               debugging and troubleshooting tools
  silvercode providers           manage AI providers and credentials                 [aliases: auth]
  silvercode agent               manage agents
  silvercode upgrade [target]    upgrade silvercode to the latest or a specific version
  silvercode uninstall           uninstall silvercode and remove all related files
  silvercode serve               starts a headless silvercode server
  silvercode models [provider]   list all available models
  silvercode stats               show token usage and cost statistics
  silvercode export [sessionID]  export session data as JSON
  silvercode import <file>       import session data from JSON file or URL
  silvercode github              manage GitHub agent
  silvercode pr <number>         fetch and checkout a GitHub PR branch, then run silvercode
  silvercode session             manage sessions
  silvercode plugin <module>     install plugin and update config                    [aliases: plug]
  silvercode db                  database tools

Positionals:
  project  path to start silvercode in                                                      [string]

Options:
  -h, --help             show help                                                         [boolean]
  -v, --version          show version number                                               [boolean]
      --print-logs       print logs to stderr                                              [boolean]
      --log-level        log level              [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure             run without external plugins                                      [boolean]
      --port             port to listen on                                     [number] [default: 0]
      --hostname         hostname to listen on                       [string] [default: "127.0.0.1"]
      --mdns             enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain      custom domain name for mDNS service (default: silvercode.local)
                                                              [string] [default: "silvercode.local"]
      --cors             additional domains to allow for CORS                  [array] [default: []]
  -m, --model            model to use in the format of provider/model                       [string]
  -c, --continue         continue the last session                                         [boolean]
  -s, --session          session id to continue                                             [string]
      --fork             fork the session when continuing (use with --continue or --session)
                                                                                           [boolean]
      --prompt           prompt to use                                                      [string]
      --agent            agent to use                                                       [string]
      --auto             auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]
      --mini             start the minimal interactive interface          [boolean] [default: false]
      --no-replay        disable mini session history replay on resume and after resize    [boolean]
      --replay-limit     cap visible mini replay to the newest N messages                   [number]
      --factory-default  reset user-level config, data, state, and cache to factory defaults, then
                         exit                                                              [boolean]
      --dry-run          with --factory-default, print what would be removed without removing
                                                                                           [boolean]
  -y, --yes              with --factory-default, skip the confirmation prompt              [boolean]
"
`;

